{
  "name": "@duelcade/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative API and Colyseus game server for Duelcade.",
  "scripts": {
    "dev": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "colyseus": "0.17.10",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
